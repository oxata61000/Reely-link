{
  "rewrites": [
    { "source": "/ig/:slug*", "destination": "/index.html" },
    { "source": "/fb/:slug*", "destination": "/index.html" },
    { "source": "/li/:slug*", "destination": "/index.html" },
    { "source": "/tt/:slug*", "destination": "/index.html" },
    { "source": "/yt/:slug*", "destination": "/index.html" },
    { "source": "/:slug", "destination": "/index.html?u=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Frame-Options", "value": "DENY" }]
    },
    {
      "source": "/login.html",
      "headers": [{ "key": "X-Frame-Options", "value": "DENY" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }]
    }
  ]
}
